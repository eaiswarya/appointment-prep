# Copy to .env (git-ignored) and fill in real values. TECHNICAL_DESIGN §12.3.
# Every value below is a placeholder for local development only.

# Database
POSTGRES_USER=appointments
POSTGRES_PASSWORD=change-me-local-only

# Auth: HMAC key, at least 256 bits. Deliberately empty: the app and Compose refuse to start
# without a real one. Generate it with: openssl rand -base64 48
APP_JWT_SECRET=

# Links in emails
APP_BASE_URL=http://localhost:8080

# SMTP (the dev override points these at Mailpit)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@appointment-prep.local

# Admin created on first start if none exists
APP_ADMIN_EMAIL=admin@appointment-prep.local
APP_ADMIN_INITIAL_PASSWORD=change-me-local-only
